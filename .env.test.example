# ===== ТЕСТОВАЯ СРЕДА =====
# start_test.bat копирует этот файл в .env.test (если его ещё нет).
# ВАЖНО: BOT_TOKEN здесь — от ОТДЕЛЬНОГО тестового бота (@BotFather → /newbot).
# Если вставить токен боевого бота, тест и сервер будут мешать друг другу.
BOT_TOKEN=

# Твой Telegram ID (узнать у @userinfobot). Можно один и тот же в обоих полях.
ADMIN_IDS=
SUPPORT_IDS=

# Рабочая группа сотрудников. Узнать ID: добавьте бота в группу и напишите там /chatid
STAFF_CHAT_ID=

# Курс и лимиты
USDT_RATE_RUB=90
SPREAD_PERCENT=2
MIN_AMOUNT_RUB=3000
MAX_AMOUNT_RUB=150000
PAYMENT_TTL_MINUTES=20

# Автокурс (берёт реальные курсы Rapira / Bybit). Поставь static, чтобы без интернета.
RATE_MODE=auto
RATE_FORMULA=spread
RATE_REFRESH_SEC=60

MARKUP_RUB_DEFAULT=1
CC_EDGE_PERCENT=2
AMOUNT_TIER_30K=30000
AMOUNT_TIER_40K=40000
AMOUNT_DISCOUNT_30K=0.2
AMOUNT_DISCOUNT_40K=0.3
MIN_MARGIN_PERCENT=1
MIN_MARGIN_PERCENT_40K=0.5

CC_RATE_SOURCE=bybit_sber20
BYBIT_PAYMENT_ID=585
BYBIT_SIDE=1
BYBIT_AD_INDEX=20

# Отдельная тестовая база — боевые заявки не трогаются
DATABASE_PATH=data/test/exchange.db

# Проверка чеков заглушкой: файл с "fail" в имени → чек отклонён, иначе принят
RECEIPT_PROVIDER=mock
RECEIPT_API_TIMEOUT_SEC=30
RECEIPT_FAIL_OPEN_TO_SUPPORT=true
