# Copy on the server only:
#   cp deploy/env.prod.example .env && chmod 600 .env
# Never commit the real .env / .env.prod

BOT_TOKEN=123456:replace-me
ADMIN_IDS=111111111
PAYMENT_TITLE=Оплата VPN
PAYMENT_DETAILS=СБП +7 900 000-00-00, получатель Иван И.
PAYMENT_QR_PAYLOAD=
SUPPORT_CONTACT=@support

POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql+asyncpg://vpnbot:replace-with-strong-password@db:5432/vpnbot
AUTO_CREATE_SQLITE=false

PANEL_ENABLED=false
PANEL_PROVIDER=marzban
PANEL_BASE_URL=https://panel.example.com
PANEL_USERNAME=admin
PANEL_PASSWORD=replace-me
PANEL_PROXIES_JSON={"vless": {}}
PANEL_INBOUNDS_JSON={}

STARS_ENABLED=false

LOG_JSON=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
HEARTBEAT_PATH=/tmp/bot_heartbeat
HEARTBEAT_SECONDS=30
HEARTBEAT_ALERT_SECONDS=0
HEARTBEAT_STARTUP_NOTIFY=false

ORDER_COOLDOWN_SECONDS=30
PAID_COOLDOWN_SECONDS=20
REMINDER_DAYS_BEFORE=3
REMINDER_INTERVAL_SECONDS=3600
BROADCAST_DELAY_SECONDS=0.05
EXPORT_DAYS=30
