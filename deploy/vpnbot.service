[Unit]
Description=VPN Telegram bot (Docker Compose prod)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=deploy
Group=docker
WorkingDirectory=/opt/vpn-bot
ExecStart=/usr/bin/docker compose -f compose.prod.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f compose.prod.yml stop
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
