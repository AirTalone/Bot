BOT_TOKEN=123456:replace-me
ADMIN_IDS=111111111,222222222

# Local quickstart (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# AUTO_CREATE_SQLITE=true

# Docker Compose default (Postgres). Compose overrides host to `db`.
DATABASE_URL=postgresql+asyncpg://vpnbot:vpnbot@127.0.0.1:5432/vpnbot
AUTO_CREATE_SQLITE=false
POSTGRES_PASSWORD=vpnbot
POSTGRES_PORT=5432

PAYMENT_TITLE=Оплата VPN
PAYMENT_DETAILS=СБП +7 900 000-00-00, получатель Иван И.
PAYMENT_QR_PAYLOAD=
SUPPORT_CONTACT=@support

# Marzban panel (see docs/MARZBAN.md). Keep false until the panel is ready.
PANEL_ENABLED=false
PANEL_PROVIDER=marzban
PANEL_BASE_URL=https://panel.example.com
PANEL_USERNAME=admin
PANEL_PASSWORD=replace-me
PANEL_PROXIES_JSON={"vless": {}}
PANEL_INBOUNDS_JSON={}

# UX / antispam / reminders
ORDER_COOLDOWN_SECONDS=30
PAID_COOLDOWN_SECONDS=20
REMINDER_DAYS_BEFORE=3
REMINDER_INTERVAL_SECONDS=3600
BROADCAST_DELAY_SECONDS=0.05
EXPORT_DAYS=30

# Telegram Stars (XTR). Keep false until BotFather payments / Stars are ready.
# QR/перевод остаётся fallback при STARS_ENABLED=true.
STARS_ENABLED=false

# Reliability
LOG_JSON=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
HEARTBEAT_PATH=/tmp/bot_heartbeat
HEARTBEAT_SECONDS=30
# 0 = не слать периодический ping админам (файл heartbeat всё равно пишется)
HEARTBEAT_ALERT_SECONDS=0
HEARTBEAT_STARTUP_NOTIFY=false
