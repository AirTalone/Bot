BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather

# Telegram user id через запятую (узнать у @userinfobot)
ADMIN_IDS=123456789
SUPPORT_IDS=123456789,987654321

# Рабочая группа сотрудников (карточки заявок + кнопки). Пусто — уведомления в личку.
# Узнать ID: добавьте бота в группу и напишите там /chatid
STAFF_CHAT_ID=

# Оператор поддержки для клиентов (кнопка «💬 Поддержка»), без @
SUPPORT_CONTACT=Georgina771

# Курс и лимиты
USDT_RATE_RUB=90
SPREAD_PERCENT=2
MIN_AMOUNT_RUB=3000
MAX_AMOUNT_RUB=150000
PAYMENT_TTL_MINUTES=20

# Автокурс
RATE_MODE=auto
# spread = Rapira+markup, CC только для закупа/маржи (рекомендуется)
# max | min | avg — старые формулы (база + SPREAD_PERCENT)
RATE_FORMULA=spread
RATE_REFRESH_SEC=60

# Формула spread (по опросу):
# клиенту: Rapira + MARKUP_RUB_DEFAULT
# скидка к курсу: >AMOUNT_TIER_30K → −AMOUNT_DISCOUNT_30K; >40к → −AMOUNT_DISCOUNT_40K
# себестоимость закупа: CC × (1 − CC_EDGE_PERCENT/100)
# мин. маржа: ≤40к → MIN_MARGIN_PERCENT; >40к → MIN_MARGIN_PERCENT_40K
# финальный курс / брать сделку решает саппорт
MARKUP_RUB_DEFAULT=1
CC_EDGE_PERCENT=2
AMOUNT_TIER_30K=30000
AMOUNT_TIER_40K=40000
AMOUNT_DISCOUNT_30K=0.2
AMOUNT_DISCOUNT_40K=0.3
MIN_MARGIN_PERCENT=1
MIN_MARGIN_PERCENT_40K=0.5

# Вторая нога курса (логика CryptoCards без логина):
# bybit_sber20 = 20-е объявление Bybit P2P Сбер + среднее за сутки (МСК)
# api = кабинет CryptoCards /api/account (нужен x-token / x-ukey)
CC_RATE_SOURCE=bybit_sber20
BYBIT_PAYMENT_ID=585
BYBIT_SIDE=1
BYBIT_AD_INDEX=20
# BYBIT_AMOUNT=100000

# Если CC_RATE_SOURCE=api — взять из Dolphin Local Storage:
#   token → CRYPTOCARDS_TOKEN
#   ukey  → CRYPTOCARDS_UKEY
CRYPTOCARDS_API_URL=https://cryptocards.ws/api/account
CRYPTOCARDS_RATE_FIELD=rate
# CRYPTOCARDS_TOKEN=...
# CRYPTOCARDS_UKEY=...

DATABASE_PATH=data/exchange.db

RECEIPT_PROVIDER=mock
RECEIPT_API_TIMEOUT_SEC=30
RECEIPT_FAIL_OPEN_TO_SUPPORT=true
