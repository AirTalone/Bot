BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather

# Telegram user id через запятую (узнать у @userinfobot)
ADMIN_IDS=123456789
SUPPORT_IDS=123456789,987654321

# Курс и лимиты
# USDT_RATE_RUB — запасной курс, если источники недоступны
USDT_RATE_RUB=90
SPREAD_PERCENT=2
MIN_AMOUNT_RUB=1000
MAX_AMOUNT_RUB=500000
PAYMENT_TTL_MINUTES=20

# Автокурс: Rapira + CryptoCards
# RATE_MODE=static — только USDT_RATE_RUB
# RATE_MODE=auto — тянем Rapira и CryptoCards
RATE_MODE=auto
# Как свести два курса: max | min | avg
RATE_FORMULA=max
RATE_REFRESH_SEC=60

# CryptoCards: URL уже найден вами
CRYPTOCARDS_API_URL=https://cryptocards.ws/api/account
CRYPTOCARDS_RATE_FIELD=rate
# Из DevTools → Headers запроса /api/account:
# либо целиком Authorization: ...
# CRYPTOCARDS_AUTHORIZATION=Bearer ВАШ_ТОКЕН
# либо только токен:
# CRYPTOCARDS_TOKEN=ВАШ_ТОКЕН
# либо Cookie:
# CRYPTOCARDS_COOKIE=session=...

# SQLite
DATABASE_PATH=data/exchange.db

# Проверка чеков: mock (по умолчанию) или http (Fraudex / аналог)
RECEIPT_PROVIDER=mock
# RECEIPT_PROVIDER=http
# RECEIPT_API_URL=https://api.example.com/v1/check-receipt
# RECEIPT_API_KEY=your_key
RECEIPT_API_TIMEOUT_SEC=30
RECEIPT_FAIL_OPEN_TO_SUPPORT=true
